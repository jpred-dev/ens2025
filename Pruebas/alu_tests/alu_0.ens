;Adaptado de ENS-PRI-009 para ENS2001
;Añadidas instrucciones de escritura para mostrar la correcta escritura de los valores donde corresponde.
;Corregido para que la instrucción MOVE #0xFA, #127[.IY] no sobrescriba instrucciones debido a la longitud añadida al código.

MOVE #0xFE,.R4
WRINT .R4
WRSTR /0x1000

MOVE #0xA000, .IX
WRINT .IX
WRSTR /0x1000

MOVE #0xF000, .IY
WRINT .IY
WRSTR /0x1000

MOVE #0xFD,/3000
WRINT /3000
WRSTR /0x1000

MOVE #0xFC,[.R6]
WRINT [.R6]
WRSTR /0x1000

MOVE #0xFB,#0xFF[.IX]
WRINT #0xFF[.IX]
WRSTR /0x1000

MOVE #0xFA,#127[.IY]
WRINT #127[.IY]
WRSTR /0x1000

;prueba de modos de direccionamiento
;1 operando
INC /3000
WRINT /3000
WRCHAR #10
WRINT .SR
WRSTR /0x1000

INC .R4
WRINT .R4
WRCHAR #10
WRINT .SR
WRSTR /0x1000

DEC [.R6]
WRINT [.R6]
WRCHAR #10
WRINT .SR
WRSTR /0x1000

NEG #0xFF[.IX]
WRINT #0xFF[.IX]
WRCHAR #10
WRINT .SR
WRSTR /0x1000

NEG #127[.IY]
WRINT #127[.IY]
WRCHAR #10
WRINT .SR
WRSTR /0x1000

;2 operandos
ADD #255,#255
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

ADD #255,/3000
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

ADD #255,.R4
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

ADD #255,[.R6]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

ADD #255,#0xFF[.IX]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

ADD #255,#127[.IY]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

SUB /3000,#255
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

SUB /3000,/3000
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

SUB /3000,.R4
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

SUB /3000,[.R6]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

SUB /3000,#0xFF[.IX]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

SUB /3000,#127[.IY]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MUL .R4,#255
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MUL .R4,/3000
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MUL .R4,.R4
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MUL .R4,[.R6]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MUL .R4,#0xFF[.IX]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MUL .R4,#127[.IY]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

DIV [.R6],#255
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

DIV [.R6],/3000
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

DIV [.R6],.R4
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

DIV [.R6],[.R6]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

DIV [.R6],#0xFF[.IX]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MOD #0xFF[.IX],#255
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MOD #0xFF[.IX],/3000
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MOD #0xFF[.IX],.R4
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MOD #0xFF[.IX],[.R6]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MOD #0xFF[.IX],#0xFF[.IX]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MOD #0xFF[.IX],#127[.IY]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

CMP #127[.IY],#255
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

CMP #127[.IY],/3000
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

CMP #127[.IY],.R4
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

CMP #127[.IY],[.R6]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

CMP #127[.IY],#0xFF[.IX]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

CMP #127[.IY],#127[.IY]
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

;prueba de biestables y resultados
CMP #89,#89 ;Z
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

INC .R2 ;NZ
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

ADD #-425,#3333 ; P
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

SUB #-425,#4444 ; N
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

MUL #0xFFFF,#3 ; V
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

DIV #64,#4 ; NV
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

ADD #32767,#1 ; C
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

SUB #32767,#1 ; NC
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

ADD #0,#0x6666 ; PE
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

SUB #0x6666,#1 ; PO
WRINT .A
WRCHAR #10
WRINT .SR
WRSTR /0x1000

HALT

ORG 0x1000
DATA 10, 10, 0 ;String con dos saltos de línea y un fin de cadena.


END